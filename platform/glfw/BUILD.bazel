load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# Ports platform/glfw (the GLFW example app) on the WebGPU backend.
GLFW_DEPS = [
    "//crates/mln_actor",
    "//crates/mln_gfx",
    "//crates/mln_map",
    "//crates/mln_math",
    "//crates/mln_platform_default_image",
    "//crates/mln_renderer",
    "//crates/mln_storage",
    "//crates/mln_style",
    "//crates/mln_util",
    "//crates/mln_webgpu",
    "//vendor/feature",
    "@next_crates//:glfw",
    "@next_crates//:serde_json",
    "@next_crates//:wgpu",
]

rust_library(
    name = "mln_glfw",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_root = "src/lib.rs",
    visibility = ["//visibility:public"],
    deps = GLFW_DEPS,
)

# The app: OpenFreeMap Liberty in a window (main.cpp). Run it from
# bazel-bin inside the dev shell (Vulkan loader on LD_LIBRARY_PATH).
rust_binary(
    name = "mln-glfw",
    srcs = ["src/main.rs"],
    crate_name = "mln_glfw_main",
    deps = GLFW_DEPS + [":mln_glfw"],
)

# Opens a window, clears its wgpu surface through the gfx path, reads the
# presented frame back and checks it. Needs a display (Wayland or X11).
rust_binary(
    name = "glfw_surface_smoke",
    srcs = ["tools/surface_smoke.rs"],
    deps = [
        ":mln_glfw",
        "//crates/mln_gfx",
        "//crates/mln_util",
        "@next_crates//:glfw",
    ],
)

# Loads the OpenFreeMap Liberty style over HTTPS through the Map's file
# sources (OnlineFileSource -> HTTPFileSource) and Style::loadURL, and parses
# it. Needs network access.
rust_test(
    name = "liberty_style_test",
    srcs = ["tests/liberty_style_test.rs"],
    tags = ["requires-network"],
    deps = GLFW_DEPS + [":mln_glfw"],
)
