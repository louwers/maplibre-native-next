load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# Ports expression-test/ (the expression corpus runner) of the C++ repo.
rust_library(
    name = "expression_test",
    srcs = [
        "src/lib.rs",
        "src/parser.rs",
        "src/runner.rs",
        "src/test_runner_common.rs",
    ],
    deps = [
        "//crates/mln_conversion",
        "//crates/mln_expression",
        "//crates/mln_style",
        "//crates/mln_tile_id",
        "//crates/mln_util",
        "//vendor/csscolorparser",
        "//vendor/feature",
        "//vendor/geometry",
        "@next_crates//:serde_json",
    ],
)

# `just bazel run //tools/expression-test -- [test names...]`
rust_binary(
    name = "expression-test",
    srcs = ["src/main.rs"],
    data = ["@maplibre//metrics:expression-test-files"],
    deps = [":expression_test"],
)

# Runs the whole corpus; fails only on tests that fail but are not listed in
# expected_failures.txt (so it stays green while the engine is incomplete).
rust_test(
    name = "corpus_test",
    srcs = ["src/corpus_test.rs"],
    data = [
        "expected_failures.txt",
        "@maplibre//metrics:expression-test-files",
    ],
    deps = [":expression_test"],
)
