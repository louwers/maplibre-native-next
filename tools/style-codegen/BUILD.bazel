load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# Ports scripts/generate-style-code.mjs, scripts/style-code.mjs,
# scripts/style-spec.mjs and the style .ejs templates of the C++ repo.
rust_library(
    name = "style_codegen",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = [
            "src/main.rs",
            "src/generated_code_test.rs",
        ],
    ),
    visibility = ["//difftest/style_codegen:__pkg__"],
    deps = [
        "//vendor/csscolorparser",
        "@next_crates//:serde_json",
    ],
)

rust_test(
    name = "style_codegen_test",
    crate = ":style_codegen",
)

# Regenerates the checked-in files: `just generate-style-code`.
rust_binary(
    name = "style-codegen",
    srcs = ["src/main.rs"],
    visibility = ["//difftest/style_codegen:__pkg__"],
    deps = [":style_codegen"],
)

# The C++ repo's `generate.py --check` for plugins, for the style code:
# fails when crates/mln_style's generated files differ from fresh output.
rust_test(
    name = "generated_code_test",
    srcs = ["src/generated_code_test.rs"],
    data = [
        "//crates/mln_style:generated_style_code",
        "@maplibre//:scripts/style-spec-reference/v8.json",
    ],
    deps = [":style_codegen"],
)
