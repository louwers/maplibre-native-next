load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports vendor/maplibre-native-base/deps/cheap-ruler-cpp (header-only
# mapbox/cheap_ruler.hpp).
rust_library(
    name = "cheap_ruler",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = ["//vendor/geometry"],
)

rust_test(
    name = "cheap_ruler_test",
    crate = ":cheap_ruler",
)

# Port of cheap-ruler-cpp/test/cheap_ruler.cpp over its fixtures (C++
# headers with the turf.js expectations), read in place.
rust_test(
    name = "cheap_ruler_fixtures_test",
    srcs = ["tests/cheap_ruler.rs"],
    data = ["@maplibre//vendor:cheap_ruler_fixtures"],
    deps = [
        ":cheap_ruler",
        "//vendor/geometry",
    ],
)
