load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports ../maplibre-native/vendor/wagyu (mapbox::geometry::wagyu 0.5.0,
# 9c87e553), the polygon clipper behind tile/geometry_tile_data.cpp's
# fixupPolygons, for the instantiation the C++ core uses: wagyu<int32_t>.
rust_library(
    name = "wagyu",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//vendor/geometry",
        "//vendor/libstdcxx",
    ],
)

rust_test(
    name = "wagyu_test",
    crate = ":wagyu",
)
