load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports ../maplibre-native/vendor/vector-tile (mapbox::vector_tile 1.0.5):
# the MVT reader (buffer, layer, feature, value and geometry decoding).
rust_library(
    name = "vector_tile",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//vendor/feature",
        "//vendor/geometry",
        "//vendor/protozero",
    ],
)

# Ports vendor/vector-tile/test/unit/{tags,vector_tile}.test.cpp.
rust_test(
    name = "vector_tile_test",
    crate = ":vector_tile",
    data = ["@maplibre//vendor:vector-tile-fixtures"],
)
