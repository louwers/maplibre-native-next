load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports vendor/maplibre-native-base/deps/geojson-vt-cpp (header-only
# mapbox/geojsonvt.hpp and mapbox/geojsonvt/*.hpp).
rust_library(
    name = "geojson_vt",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//vendor/feature",
        "//vendor/geojson",
        "//vendor/geometry",
        "//vendor/libstdcxx",
    ],
)

rust_test(
    name = "geojson_vt_test",
    crate = ":geojson_vt",
)

# The fixture-free tests of geojson-vt-cpp/test/test.cpp.
rust_test(
    name = "geojsonvt_test",
    srcs = ["tests/geojsonvt.rs"],
    deps = [
        ":geojson_vt",
        "//vendor/feature",
        "//vendor/geojson",
        "//vendor/geometry",
    ],
)

# The fixture tests of geojson-vt-cpp/test/test.cpp, read in place.
rust_test(
    name = "geojsonvt_fixtures_test",
    srcs = ["tests/fixtures.rs"],
    data = ["@maplibre//vendor:geojson_vt_fixtures"],
    deps = [
        ":geojson_vt",
        "//vendor/feature",
        "//vendor/geojson",
        "//vendor/geometry",
        "@next_crates//:serde_json",
    ],
)
