load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports mapbox::feature (feature.hpp of geometry.hpp, in the C++ core's
# vendor/maplibre-native-base/deps).
rust_library(
    name = "feature",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = ["//vendor/geometry"],
)

rust_test(
    name = "feature_test",
    crate = ":feature",
)
