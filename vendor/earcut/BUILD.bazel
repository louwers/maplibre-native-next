load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports vendor/earcut.hpp (header-only mapbox/earcut.hpp).
rust_library(
    name = "earcut",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//vendor/libstdcxx",
        "//vendor/maplibre-native-base:maplibre_native_base",
    ],
)

rust_test(
    name = "earcut_test",
    crate = ":earcut",
)

# Reader for earcut.hpp/test/fixtures/*.cpp (shared with //difftest/geometry).
rust_library(
    name = "earcut_test_fixtures",
    testonly = True,
    srcs = ["test_fixtures/src/lib.rs"],
    data = ["@maplibre//vendor:earcut_fixtures"],
    visibility = [
        "//difftest/earcut_crate:__pkg__",
        "//difftest/geometry:__pkg__",
    ],
)

# Port of earcut.hpp/test/test.cpp over its fixtures, read in place.
rust_test(
    name = "earcut_fixtures_test",
    srcs = ["tests/fixtures.rs"],
    data = ["@maplibre//vendor:earcut_fixtures"],
    deps = [
        ":earcut",
        ":earcut_test_fixtures",
    ],
)
