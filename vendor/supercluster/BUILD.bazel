load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports vendor/supercluster (header-only supercluster.hpp).
rust_library(
    name = "supercluster",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//vendor/feature",
        "//vendor/geometry",
        "//vendor/kdbush",
        "//vendor/libstdcxx",
    ],
)

rust_test(
    name = "supercluster_test",
    crate = ":supercluster",
)

# Port of supercluster/test/test.cpp over test/fixtures/places.json, read in
# place.
rust_test(
    name = "supercluster_fixtures_test",
    srcs = ["tests/supercluster.rs"],
    data = ["@maplibre//vendor:supercluster_fixtures"],
    deps = [
        ":supercluster",
        "//vendor/feature",
        "//vendor/geometry",
        "@next_crates//:serde_json",
    ],
)
