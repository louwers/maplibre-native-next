load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports vendor/maplibre-native-base/deps/geojson.hpp (mapbox::geojson:
# parse, convert, stringify), as src/mln/util/geojson_impl.cpp compiles it.
rust_library(
    name = "geojson",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//vendor/feature",
        "//vendor/geometry",
        "//vendor/rapidjson",
        "@next_crates//:serde_json",
    ],
)

rust_test(
    name = "geojson_test",
    crate = ":geojson",
)

# Port of geojson.hpp/test/test.cpp over its fixtures, read in place.
rust_test(
    name = "geojson_fixtures_test",
    srcs = ["tests/geojson.rs"],
    data = ["@maplibre//vendor:geojson_fixtures"],
    deps = [
        ":geojson",
        "@next_crates//:serde_json",
    ],
)
