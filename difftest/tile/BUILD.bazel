load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_test")
load("//third_party/sqlite:defs.bzl", "ORACLE_SQLITE")

# Differential tests: //vendor/protozero, //vendor/vector-tile,
# //vendor/wagyu and //crates/mln_tile against the C++ core
# (VectorMVTTileData, geometry_tile_data.cpp, wagyu).

cc_library(
    name = "exception_kind",
    srcs = ["exception_kind.cpp"],
    copts = [
        "-std=c++20",
        "-fexceptions",
    ],
    deps = ["@maplibre//vendor:protozero"],
)

cc_library(
    name = "reference",
    srcs = [
        "platform_shims.cpp",
        "reference.cpp",
    ],
    copts = [
        "-std=c++20",
        "-fexceptions",
        "-fno-rtti",
        "-Wno-deprecated-declarations",
    ],
    # platform_shims.cpp defines symbols that mbgl-core needs.
    alwayslink = True,
    deps = [
        ":exception_kind",
        "@maplibre//:mbgl-core",
        "@maplibre//vendor:protozero",
        "@maplibre//vendor:vector-tile",
        "@maplibre//vendor:wagyu",
    ],
)

TILE_DATA = [
    "@maplibre//metrics:render-test-files",
    "@maplibre//test:fixtures",
    "@maplibre//vendor:protozero-test-data",
    "@maplibre//vendor:vector-tile-fixtures",
]

rust_test(
    name = "tile_difftest",
    # The comparison is pinned to the Linux oracle (glibc libm/strtod,
    # libstdc++ hashing, x86-64 conversions, FMA contraction): the C++
    # itself behaves differently on macOS/arm64.
    target_compatible_with = ["@platforms//os:linux"],
    size = "large",
    srcs = [
        "dump.rs",
        "tile_difftest.rs",
    ],
    crate_root = "tile_difftest.rs",
    data = TILE_DATA,
    link_deps = ORACLE_SQLITE + [":reference"],
    deps = [
        "//crates/mln_tile",
        "//crates/mln_tile_id",
        "//crates/mln_util",
        "//vendor/maplibre-native-base:maplibre_native_base",
        "//vendor/protozero",
        "//vendor/vector-tile:vector_tile",
        "@next_crates//:flate2",
        "@next_crates//:proptest",
        "@next_crates//:rusqlite",
    ],
)

rust_test(
    name = "geometry_difftest",
    # The comparison is pinned to the Linux oracle (glibc libm/strtod,
    # libstdc++ hashing, x86-64 conversions, FMA contraction): the C++
    # itself behaves differently on macOS/arm64.
    target_compatible_with = ["@platforms//os:linux"],
    size = "medium",
    srcs = [
        "dump.rs",
        "geometry_difftest.rs",
    ],
    crate_root = "geometry_difftest.rs",
    link_deps = [":reference"],
    deps = [
        "//crates/mln_tile",
        "//crates/mln_tile_id",
        "//crates/mln_util",
        "//vendor/maplibre-native-base:maplibre_native_base",
        "//vendor/vector-tile:vector_tile",
        "//vendor/wagyu",
        "@next_crates//:proptest",
    ],
)

cc_library(
    name = "pbf_reference",
    srcs = ["pbf_reference.cpp"],
    copts = [
        "-std=c++20",
        "-fexceptions",
    ],
    deps = ["@maplibre//vendor:protozero"],
)

rust_test(
    name = "pbf_difftest",
    size = "medium",
    srcs = ["pbf_difftest.rs"],
    data = TILE_DATA,
    link_deps = [":pbf_reference"],
    deps = [
        "//vendor/protozero",
        "@next_crates//:proptest",
    ],
)
