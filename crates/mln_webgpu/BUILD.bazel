load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# Extracts the WGSL raw string literals from the C++ headers
# (include/mln/shaders/webgpu/*.hpp), unchanged. `just vendor-shaders` runs
# it to write src/shaders/wgsl_sources.rs, which is checked in.
rust_binary(
    name = "extract_wgsl",
    srcs = ["tools/extract_wgsl.rs"],
)

# Ports src/mln/webgpu, include/mln/webgpu, include/mln/shaders/webgpu,
# src/mln/shaders/webgpu and the WebGPU headless backend (platform/default).
rust_library(
    name = "mln_webgpu",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//crates/mln_gfx",
        "//crates/mln_tile_id",
        "//crates/mln_util",
        # The instance on Emscripten (headless_backend.rs create_instance).
        "//crates/mln_wgpu_webgpu_h",
        "@next_crates//:bytemuck",
        "@next_crates//:pollster",
        "@next_crates//:wgpu",
    ],
)

rust_test(
    name = "mln_webgpu_test",
    crate = ":mln_webgpu",
)

# Headless wgpu smoke test: Vulkan (lavapipe) device, offscreen clear and
# readback. user.bazelrc passes LD_LIBRARY_PATH and VK_DRIVER_FILES.
rust_test(
    name = "smoke_test",
    srcs = ["tests/smoke_test.rs"],
    deps = [
        "@next_crates//:pollster",
        "@next_crates//:wgpu",
    ],
)

# The background shader end to end on the drawable path: HeadlessBackend,
# BackgroundShader from the registry, a DrawableBuilder drawable in a
# TileLayerGroup with the UBOs background_layer_tweaker.cpp sets, rendered
# into the offscreen target and read back.
rust_test(
    name = "background_test",
    srcs = ["tests/background_test.rs"],
    deps = [
        ":mln_webgpu",
        "//crates/mln_gfx",
        "//crates/mln_tile_id",
        "//crates/mln_util",
        "@next_crates//:bytemuck",
    ],
)

# Ports test/renderer/wgsl_preprocessor.test.cpp
rust_test(
    name = "shader_group_preprocessor_test",
    srcs = ["tests/shader_group_preprocessor.rs"],
    deps = [":mln_webgpu"],
)

# Compiles all extracted WGSL with wgpu (naga); the M1 shaders must compile.
rust_test(
    name = "wgsl_compile_test",
    srcs = ["tests/wgsl_compile_test.rs"],
    deps = [
        ":mln_webgpu",
        "//crates/mln_gfx",
        "//crates/mln_util",
    ],
)

# Ports test/util/offscreen_texture.test.cpp (marker `// gtest: Group.Name`).
rust_test(
    name = "gtest_offscreen_texture",
    srcs = ["tests/gtest_offscreen_texture.rs"],
    data = ["@maplibre//test:fixtures"],
    deps = [
        ":mln_webgpu",
        "//crates/mln_gfx",
        "//crates/mln_platform_default_image",
        "//crates/mln_util",
        "//vendor/pixelmatch",
    ],
)
