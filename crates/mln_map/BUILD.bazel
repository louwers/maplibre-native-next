load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports src/mln/map + include/mln/map (Map, Map::Impl, MapOptions, Transform,
# observers). The lower map vocabulary is //crates/mln_map_types.
rust_library(
    name = "mln_map",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//crates/mln_actor",
        "//crates/mln_map_types",
        "//crates/mln_math",
        "//crates/mln_renderer",
        "//crates/mln_storage",
        "//crates/mln_style",
        "//crates/mln_util",
        "//vendor/geometry",
    ],
)

rust_test(
    name = "mln_map_test",
    crate = ":mln_map",
)

# Ports test/util/action_journal.test.cpp (placeholders: ActionJournal is a
# TODO(port)); markers `// gtest: Group.Name`.
rust_test(
    name = "gtest_action_journal",
    srcs = ["tests/gtest_action_journal.rs"],
)
