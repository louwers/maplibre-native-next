load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports src/mln/sprite (sprite_loader, sprite_parser, sprite_loader_observer).
rust_library(
    name = "mln_sprite",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//crates/mln_actor",
        "//crates/mln_platform_default_image",
        "//crates/mln_storage",
        "//crates/mln_style_types",
        "//crates/mln_util",
        "//vendor/geometry",
        "@next_crates//:serde_json",
    ],
)

rust_test(
    name = "mln_sprite_test",
    crate = ":mln_sprite",
    data = ["@maplibre//test:fixtures"],
)
