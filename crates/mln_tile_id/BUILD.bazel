load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports include/mln/tile/tile_id.hpp and the interfaces in
# src/mln/tile/geometry_tile_data.hpp (cut point: used by util, style,
# expression and the renderer; see PLAN.md, "Crate map").
rust_library(
    name = "mln_tile_id",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//crates/mln_util",
        "//vendor/feature",
        "//vendor/geometry",
    ],
)

rust_test(
    name = "mln_tile_id_test",
    crate = ":mln_tile_id",
)
