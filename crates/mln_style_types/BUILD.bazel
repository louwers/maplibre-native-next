load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports the style vocabulary headers that util and expression include
# (PLAN.md, "Crate map"): include/mln/style/types.hpp + src/mln/style/types.cpp,
# position.hpp, rotation.hpp, variable_anchor_offset_collection.hpp/.cpp.
rust_library(
    name = "mln_style_types",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//crates/mln_math",
        "//crates/mln_util",
        "//vendor/feature",
        "//vendor/rapidjson",
    ],
)

rust_test(
    name = "mln_style_types_test",
    crate = ":mln_style_types",
)
