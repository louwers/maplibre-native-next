load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports the include/mln/map vocabulary headers that crates below mln_map need
# (camera.hpp, mode.hpp, projection_mode.hpp, bound_options.hpp, and
# transform_state). Cut point between style/renderer and the map.
rust_library(
    name = "mln_map_types",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//crates/mln_math",
        "//crates/mln_tile_id",
        "//crates/mln_util",
        "//vendor/geometry",
    ],
)

rust_test(
    name = "mln_map_types_test",
    crate = ":mln_map_types",
)
