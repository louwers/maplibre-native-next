load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports src/mln/style + include/mln/style (see src/lib.rs), plus the
# cut-point copies of the renderer/map headers style/properties.hpp needs and
# the style half of src/mln/layermanager.
rust_library(
    name = "mln_style",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//crates/mln_actor",
        "//crates/mln_conversion",
        "//crates/mln_expression",
        "//crates/mln_map_types",
        "//crates/mln_platform_default_image",
        "//crates/mln_sprite",
        "//crates/mln_storage",
        "//crates/mln_style_types",
        "//crates/mln_text",
        "//crates/mln_tile_id",
        "//crates/mln_util",
        "//vendor/feature",
        "//vendor/geojson",
        "//vendor/geojson-vt:geojson_vt",
        "//vendor/geometry",
        "//vendor/rapidjson",
        "//vendor/supercluster",
        "@next_crates//:serde_json",
    ],
)

rust_test(
    name = "mln_style_test",
    crate = ":mln_style",
    deps = ["//crates/mln_tile"],
    data = [
        "@maplibre//metrics:render-test-files",
        "@maplibre//test:fixtures",
    ],
)

# The files //tools/style-codegen writes (checked in), for its
# generated_code_test.
filegroup(
    name = "generated_style_code",
    srcs = glob([
        "src/layers/*_layer.rs",
        "src/layers/*_layer_properties.rs",
    ]) + ["src/light.rs"],
    visibility = ["//tools/style-codegen:__pkg__"],
)
