    name = "gtest_map",
    srcs = [
        "tests/gtest_map.rs",
        "tests/gtest_map_snapshotter.rs",
        "tests/gtest_prefetch.rs",
        "tests/support/mod.rs",
    ],
    crate_root = "tests/gtest_map.rs",
    data = ["@maplibre//test:fixtures"],
    deps = [
        ":mln_platform_default",
        "//crates/mln_actor",
        "//crates/mln_gfx",
        "//crates/mln_map",
        "//crates/mln_math",
        "//crates/mln_platform_default_image",
        "//crates/mln_renderer",
        "//crates/mln_storage",
        "//crates/mln_style",
        "//crates/mln_util",
        "//crates/mln_webgpu",
        "//vendor/feature",
        "//vendor/geojson",
        "//vendor/pixelmatch",
        "@next_crates//:serde_json",
    ],
)

