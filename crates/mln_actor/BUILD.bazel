load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports src/mln/actor and util/{run_loop,async_task,thread,thread_pool} with
# the platform/default loop, and platform/settings (gtests-core).
rust_library(
    name = "mln_actor",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//crates/mln_util",
        "//vendor/feature",
    ],
)

rust_test(
    name = "mln_actor_test",
    crate = ":mln_actor",
)

# Ported C++ gtests (test/actor, test/platform and the thread/loop parts of
# test/util);
# markers `// gtest: Group.Name`. One test at a time, as gtest runs them:
# they share the background pool, the sequenced schedulers and its
# exception handler.
rust_test(
    name = "mln_actor_gtest",
    srcs = glob(["tests/gtest/*.rs"]),
    args = ["--test-threads=1"],
    crate_root = "tests/gtest/main.rs",
    deps = [
        ":mln_actor",
        "//crates/mln_util",
        "//vendor/feature",
    ],
)
