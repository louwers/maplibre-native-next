load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports include/mln/style/conversion.hpp, include/mln/style/conversion_impl.hpp
# (Convertible), src/mln/style/rapidjson_conversion.hpp (as the serde_json
# front end) and src/mln/style/conversion/get_json_type.cpp.
rust_library(
    name = "mln_conversion",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//vendor/feature",
        "//vendor/geojson",
        "@next_crates//:serde_json",
    ],
)

rust_test(
    name = "mln_conversion_test",
    crate = ":mln_conversion",
)
