load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports platform/default/src/mln/storage/offline_download.cpp (OfflineDownload)
# and the canonicalize* half of src/mln/util/mapbox.cpp. The offline download
# parses styles and covers regions with tiles, so it sits above mln_style and
# mln_renderer instead of in mln_storage.
rust_library(
    name = "mln_storage_offline",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//crates/mln_actor",
        "//crates/mln_conversion",
        "//crates/mln_renderer",
        "//crates/mln_storage",
        "//crates/mln_style",
        "//crates/mln_style_types",
        "//crates/mln_text",
        "//crates/mln_tile_id",
        "//crates/mln_util",
        "//vendor/feature",
        "@next_crates//:regex",
    ],
)

rust_test(
    name = "mln_storage_offline_test",
    crate = ":mln_storage_offline",
    data = ["@maplibre//test:fixtures"],
    deps = ["//crates/mln_platform_default_image"],
)

# OfflineDownload.ResourceOfflineUsageUnset renders a map after the
# download.
rust_test(
    name = "offline_download_map_test",
    srcs = ["tests/offline_download_map.rs"],
    data = ["@maplibre//test:fixtures"],
    deps = [
        ":mln_storage_offline",
        "//crates/mln_actor",
        "//crates/mln_map",
        "//crates/mln_platform_default",
        "//crates/mln_platform_default_image",
        "//crates/mln_storage",
        "//crates/mln_util",
    ],
)
