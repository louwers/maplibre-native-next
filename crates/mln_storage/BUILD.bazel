load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports src/mln/storage, include/mln/storage and platform/default/src/mln/storage
# (file sources, offline database, main resource loader) except
# offline_download.cpp (//crates/mln_storage_offline).
rust_library(
    name = "mln_storage",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//crates/mln_actor",
        "//crates/mln_platform_default_image",
        "//crates/mln_util",
        "//vendor/feature",
        "//vendor/geojson",
        "//vendor/pmtiles",
        "//vendor/rapidjson",
        "@next_crates//:rusqlite",
        "@next_crates//:serde_json",
        "@next_crates//:ureq",
    ],
)

rust_test(
    name = "mln_storage_test",
    crate = ":mln_storage",
    data = [
        "@maplibre//metrics:render-test-files",
        "@maplibre//test:fixtures",
    ],
)

# Ports test/util/http_timeout.test.cpp (marker `// gtest: Group.Name`).
rust_test(
    name = "gtest_http_timeout",
    srcs = ["tests/gtest_http_timeout.rs"],
    deps = [
        ":mln_storage",
        "//crates/mln_util",
    ],
)

# test/storage/sync_file_source.test.cpp: needs a Map (mln_map,
# mln_platform_default depend on this crate, so not in mln_storage_test).
rust_test(
    name = "sync_file_source_test",
    srcs = ["tests/sync_file_source.rs"],
    data = ["@maplibre//test:fixtures"],
    deps = [
        ":mln_storage",
        "//crates/mln_actor",
        "//crates/mln_map",
        "//crates/mln_platform_default",
        "//crates/mln_util",
    ],
)
