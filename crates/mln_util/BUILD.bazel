load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports src/mln/util + include/mln/util (the files that do not depend on
# higher modules; see PLAN.md, "Crate map").
rust_library(
    name = "mln_util",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//crates/mln_math",
        "//vendor/csscolorparser",
        "//vendor/feature",
        "//vendor/geometry",
        "//vendor/rapidjson",
    ],
)

rust_test(
    name = "mln_util_test",
    crate = ":mln_util",
)

# Ported C++ gtests of test/util (markers `// gtest: Group.Name`), for
# mln_util and the low crates next to it.
rust_test(
    name = "mln_util_gtest",
    srcs = glob(["tests/gtest/*.rs"]),
    crate_root = "tests/gtest/main.rs",
    deps = [
        ":mln_util",
        "//crates/mln_style_types",
        "//crates/mln_tile_id",
        "//vendor/nunicode",
    ],
)

# Ports test/util/padding.test.cpp: its expression cases need mln_style.
rust_test(
    name = "gtest_padding",
    srcs = ["tests/gtest_padding.rs"],
    deps = [
        ":mln_util",
        "//crates/mln_conversion",
        "//crates/mln_expression",
        "//crates/mln_style",
        "//crates/mln_tile_id",
        "//vendor/feature",
        "@next_crates//:serde_json",
    ],
)
