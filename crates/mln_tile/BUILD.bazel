load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports the tile data side of src/mln/tile (vector_mvt_tile_data.cpp,
# vector_mlt_tile_data.cpp, geometry_tile_data.cpp). A low crate: no
# style/renderer/expression deps. MLT tiles are decoded by mlt-core.
rust_library(
    name = "mln_tile",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//crates/mln_tile_id",
        "//crates/mln_util",
        "//vendor/feature",
        "//vendor/geometry",
        "//vendor/libstdcxx",
        "//vendor/protozero",
        "//vendor/vector-tile:vector_tile",
        "//vendor/wagyu",
        "@next_crates//:mlt-core",
    ],
)

# Ports test/tile/geometry_tile_data.test.cpp and test/tile/vector_tile.test.cpp.
rust_test(
    name = "mln_tile_test",
    crate = ":mln_tile",
    data = ["@maplibre//test:fixtures"],
)
