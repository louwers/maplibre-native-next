load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Ports include/mln/gfx, src/mln/gfx, the backend-independent parts of
# include/mln/shaders + src/mln/shaders, and the renderer files the backends
# implement (renderer/layer_group, renderer/render_pass). See src/lib.rs.
rust_library(
    name = "mln_gfx",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//crates/mln_style_types",
        "//crates/mln_tile_id",
        "//crates/mln_util",
        "//vendor/geometry",
        "@next_crates//:bytemuck",
    ],
)

rust_test(
    name = "mln_gfx_test",
    crate = ":mln_gfx",
)

# Ports test/renderer/shader_registry.test.cpp
rust_test(
    name = "shader_registry_test",
    srcs = ["tests/shader_registry.rs"],
    deps = [
        ":mln_gfx",
        "//crates/mln_util",
    ],
)

# gtests-core: test/renderer/renderable.test.cpp.
rust_test(
    name = "gtest_renderable",
    srcs = ["tests/gtest_renderable.rs"],
    deps = [
        ":mln_gfx",
        "//crates/mln_util",
    ],
)

# gtests-core: test/renderer/backend_scope.test.cpp (OpenGL-only in C++; the
# BackendScope logic it tests is backend-independent).
rust_test(
    name = "gtest_backend_scope",
    srcs = ["tests/gtest_backend_scope.rs"],
    deps = [":mln_gfx"],
)

# gtests-core: test/renderer/metal_renderable.test.cpp and
# vulkan_acquire.test.cpp: backend-specific, ignored placeholders.
rust_test(
    name = "gtest_metal_renderable",
    srcs = ["tests/gtest_metal_renderable.rs"],
)

rust_test(
    name = "gtest_vulkan_acquire",
    srcs = ["tests/gtest_vulkan_acquire.rs"],
)

# Ports test/util/hash.test.cpp (marker `// gtest: Group.Name`).
rust_test(
    name = "gtest_hash",
    srcs = ["tests/gtest_hash.rs"],
    deps = [":mln_gfx"],
)
